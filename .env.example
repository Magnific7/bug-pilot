GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-3.5-flash-lite"

# Repo to file issues in (owner/name)
GITHUB_REPO=""

# Default GitHub Projects board title (leave empty to skip)
GITHUB_PROJECT=""

# Named boards, picked with --board rama / --board cbhi.
# <KEY>_GITHUB_REPO is optional and falls back to GITHUB_REPO.
RAMA_GITHUB_PROJECT=""
RAMA_GITHUB_REPO=""
CBHI_GITHUB_PROJECT=""
CBHI_GITHUB_REPO=""
